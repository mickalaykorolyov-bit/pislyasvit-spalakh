      ],
      "events": [
        {
          "type": "BuiltinCommonInstructions::Comment",
          "color": {
            "b": 76,
            "g": 209,
            "r": 255,
            "textB": 0,
            "textG": 0,
            "textR": 0
          },
          "comment": "Основна механіка: Спалах світиться сильніше, коли швидше рухається. Код у наступній JavaScript-події можна редагувати."
        },
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "// ПІСЛЯСВІТ — Prototype 0.1. Editable GDevelop JavaScript event.",
            "// All visual objects (Player, Crab, platforms, sensor, background) are native sprites.",
            "// Move the Platform objects in the Scene editor to change the collision geometry.",
            "if (!runtimeScene.__spalakhPrototype) {",
            "/* ПІСЛЯСВІТ — Prototype 0.1: shared deterministic movement and stealth simulation */",
            "var SpalakhSim = (function () {",
            "  const WORLD_W = 2560;",
            "  const PLATFORMS = [",
            "    {x:0,y:616,w:730,h:104},{x:817,y:616,w:528,h:104},",
            "    {x:1455,y:616,w:558,h:104},{x:2110,y:616,w:450,h:104},",
            "    {x:412,y:498,w:250,h:45},{x:1010,y:490,w:250,h:46},",
            "    {x:1655,y:476,w:320,h:45},{x:2130,y:446,w:225,h:46}",
            "  ];",
            "  function createState(){return {",
            "    x:154,y:616,vx:0,vy:0,grounded:true,facing:1,brightness:.08,",
            "    time:0,jumpHeld:false,dashHeld:false,dashTimer:0,dashCooldown:0,",
            "    sensorOn:false,won:false,crabX:570,crabV:47,crabAlert:0,",
            "    crabY:616,deaths:0,flash:0,hint:'Рухайся обережно. Швидкість запалює Спалаха.',",
            "    paused:false",
            "  };}",
            "  function resetPosition(s){s.x=154;s.y=616;s.vx=0;s.vy=0;s.grounded=true;s.dashTimer=0;s.brightness=.08;s.flash=.55;s.deaths++;s.crabAlert=0;}",
            "  function step(s,input,dt,platforms){",
            "    dt=Math.max(0,Math.min(.04,dt||.016));",
            "    if(s.won || s.paused) return s;",
            "    const P=platforms||PLATFORMS;",
            "    s.time+=dt;s.flash=Math.max(0,s.flash-dt*1.25);",
            "    s.dashCooldown=Math.max(0,s.dashCooldown-dt);s.dashTimer=Math.max(0,s.dashTimer-dt);",
            "    const direction=(input.right?1:0)-(input.left?1:0);",
            "    const speedTarget=direction*(input.down?66:(input.boost?310:185));",
            "    if(direction) s.facing=direction;",
            "    const accelerating=direction?1080:(s.grounded?1490:860);",
            "    const maxDelta=accelerating*dt;",
            "    s.vx+=Math.max(-maxDelta,Math.min(maxDelta,speedTarget-s.vx));",
            "    if(input.dash&&!s.dashHeld&&s.dashCooldown<=0){",
            "      s.vx=s.facing*645;s.dashTimer=.15;s.dashCooldown=1.25;s.flash=.34;",
            "    }",
            "    s.dashHeld=!!input.dash;",
            "    if(input.jump&&!s.jumpHeld && s.grounded){s.vy=-510;s.grounded=false;s.flash=.24;}",
            "    s.jumpHeld=!!input.jump;",
            "    if(s.dashTimer>0)s.vx=s.facing*645;",
            "    s.vy=Math.min(670,s.vy+925*dt);",
            "    const prevY=s.y;const nextY=s.y+s.vy*dt;",
            "    s.x=Math.min(WORLD_W-22,Math.max(22,s.x+s.vx*dt));",
            "    s.y=nextY;",
            "    s.grounded=false;",
            "    for(const p of P){",
            "      if(s.vy>=0 && prevY<=p.y+5 && s.y>=p.y && s.x+16>p.x && s.x-16<p.x+p.w){",
            "        s.y=p.y;s.vy=0;s.grounded=true;break;",
            "      }",
            "    }",
            "    if(s.y>815)resetPosition(s);",
            "    let desired=Math.min(1,Math.abs(s.vx)/350);",
            "    if(s.dashTimer>0)desired=1;",
            "    if(input.down)desired=Math.min(desired,.24);",
            "    if(s.flash>0)desired=Math.max(desired,.5);",
            "    s.brightness+=(Math.max(.06,desired)-s.brightness)*Math.min(1,dt*(desired>s.brightness?8:3.5));",
            "    // Crab reacts to vibrations and its small underwater territory; no combat.",
            "    const close=Math.abs(s.x-s.crabX);",
            "    const disturbance=(Math.abs(s.vx)>95 || s.dashTimer>0) && close<240 && Math.abs(s.y-s.crabY)<110;",
            "    if(disturbance)s.crabAlert=Math.min(2,s.crabAlert+dt*2.5);",
            "    else s.crabAlert=Math.max(0,s.crabAlert-dt*.56);",
            "    if(s.crabAlert>.27&&close<280){s.crabV=Math.sign(s.x-s.crabX||1)*(52+65*s.crabAlert);}",
            "    else if(s.crabX<495){s.crabV=48;}else if(s.crabX>645){s.crabV=-48;}",
            "    s.crabX+=s.crabV*dt;",
            "    if(close<39&&Math.abs(s.y-s.crabY)<55) resetPosition(s);",
            "    if(!s.sensorOn && Math.abs(s.x-1875)<86 && Math.abs(s.y-476)<150 && Math.abs(s.vx)>220){",
            "      s.sensorOn=true;s.flash=.6;s.hint='Оптичний сенсор активований! Шлюз попереду відкрито.';",
            "    }",
            "    if(s.sensorOn&&s.x>2430&&s.y>370){s.won=true;s.hint='Сигнал прокинувся. Далі — шлях до поверхні.';}",
            "    if(s.x<365 &&s.time>5)s.hint='Присідай (S або ↓), щоб зменшити світіння. Краб відчуває коливання.';",
            "    if(s.x>1520&&!s.sensorOn)s.hint='Знайди сенсор серед уламків. Йому потрібен яскравий швидкий спалах.';",
            "    if(s.x>2050&&s.sensorOn)s.hint='Портовий буй попереду. Завершіть рівень.';",
            "    return s;",
            "  }",
            "  return {WORLD_W,PLATFORMS,createState,resetPosition,step};",
            "})();",
            "",
            "  runtimeScene.__spalakhPrototype = {sim:SpalakhSim, state:SpalakhSim.createState(), cameraX:640};",
            "}",
            "const run = runtimeScene.__spalakhPrototype;",
            "const sim = run.sim;",
            "const s = run.state;",
            "const pressed = key => gdjs.evtTools.input.isKeyPressed(runtimeScene,key);",
            "const input = {",
            "  left:pressed('Left')||pressed('a'),",
            "  right:pressed('Right')||pressed('d'),",
            "  down:pressed('Down')||pressed('s'),",
            "  jump:pressed('Space')||pressed('Up')||pressed('w'),",
            "  boost:pressed('LShift')||pressed('Shift'),",
            "  dash:pressed('x')||pressed('k')",
            "};",
            "if(pressed('r')) { run.state=sim.createState(); }",
            "const a = run.state;",
            "const platformRects = runtimeScene.getObjects('Platform').map(p => ({x:p.getX(),y:p.getY(),w:p.getWidth(),h:p.getHeight()}));",
            "const delta = Math.min(.04,runtimeScene.getElapsedTimeInSeconds());",
            "sim.step(a,input,delta,platformRects.length ? platformRects : undefined);",
            "const pl = runtimeScene.getObjects('Player')[0];",
            "if (pl) {",
            "  const anim = a.dashTimer>0?'Dash':(!a.grounded?(a.vy<0?'Jump':'Fall'):(input.down?'Crouch':(Math.abs(a.vx)>215?'Run':(Math.abs(a.vx)>30?'Slow':'Idle'))));",
            "  if (pl.setAnimationName)pl.setAnimationName(anim);",
            "  pl.setPosition(a.x-322,a.y-222);",
            "  if(pl.flipX)pl.flipX(a.facing<0);",
            "  if(pl.setOpacity)pl.setOpacity(38+62*a.brightness);",
            "}",
            "const halo = runtimeScene.getObjects('Glow')[0];",
            "if (halo){halo.setPosition(a.x-244,a.y-317);if(halo.setOpacity)halo.setOpacity(12+84*a.brightness);}",
            "const crab = runtimeScene.getObjects('Crab')[0];",
            "if(crab){crab.setPosition(a.crabX-81,524);if(crab.flipX)crab.flipX(a.crabV<0);}",
            "const sensor = runtimeScene.getObjects('Sensor')[0];",
            "if(sensor && sensor.setOpacity)sensor.setOpacity(a.sensorOn ? 48:100);",
            "const gate = runtimeScene.getObjects('Gate')[0];",
            "if(gate && gate.setOpacity)gate.setOpacity(a.sensorOn?0:100);",
            "const hint=runtimeScene.getObjects('HUDHint')[0];",
            "if(hint && hint.setString)hint.setString(a.hint);",
            "const status=runtimeScene.getObjects('HUDStatus')[0];",
            "if(status && status.setString)status.setString(a.won?'ПРОТОТИП ПРОЙДЕНО':a.sensorOn?'СЕНСОР АКТИВОВАНО':'СПАЛАХ · ПІДВОДНИЙ ПОРТ');",
            "// Camera centered around player but constrained to watercolor background boundaries.",
            "const cameraTarget=Math.max(640,Math.min(1920,a.x+200));",
            "run.cameraX += (cameraTarget-run.cameraX)*Math.min(1,delta*3.4);",
            "if (gdjs.evtTools.camera.setCameraX)gdjs.evtTools.camera.setCameraX(runtimeScene,run.cameraX,'',0);"
          ],
          "parameterObjects": "",
          "useStrict": false,
          "eventsSheetExpanded": true
        }
